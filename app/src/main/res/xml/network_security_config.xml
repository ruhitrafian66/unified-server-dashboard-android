<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Plain HTTP is allowed only for the home server and other LAN-only hosts. -->
    <domain-config cleartextTrafficPermitted="true">
        <!-- Local machine -->
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>

        <!-- mDNS names such as dash.local (the home server). They only resolve on the
             local network, never on the internet. -->
        <domain includeSubdomains="true">local</domain>

        <!-- Backend server IP -->
        <domain includeSubdomains="true">192.168.0.30</domain>

        <!-- Explicit legacy hosts only; these are not private-IP ranges. -->
        <domain includeSubdomains="true">192.168.0.1</domain>
        <domain includeSubdomains="true">192.168.1.1</domain>
        <domain includeSubdomains="true">10.0.0.1</domain>
        <domain includeSubdomains="true">172.16.0.1</domain>
    </domain-config>

    <!-- All other domains require HTTPS (secure by default) -->
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
